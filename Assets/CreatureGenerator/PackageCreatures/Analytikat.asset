  m_Script: {fileID: 11500000, guid: 7b5e8b7961ac50a49b5c6a93d01b7945, type: 3}
  m_Name: Analytikat
  m_EditorClassIdentifier: 
  _packageCreatureName: Analytikat
  _packageCreatureDescription: Analytikats are derpy creatures that can be found
    fumbling around open areas in packs. They often stay in the same location for
    prolonged periods of time, primarily as they struggle to pick up things with
    their arrow shaped hands.
  _packageCreaturePersonality: "The best way to describe this peculiar creature\u2019s
    personality would be if the Sphinx had an IQ in the negatives."
  _packageCreatureWeight: 1.5
  _packageCreatureLength: 200
  _packageCreatureAbilityName: Scouting
  _packageCreatureAbilityDescription: By extending their long head up and using their
    own internal senses, Analytikat can know everything in a 25 meter radius. They
    however, can only say what they found in convoluted riddles.
  _packageCreatureDisplayImage: {fileID: 21300000, guid: c4a702315bdad604ab843c59bb02521e, type: 3}
  _abilityType: 2
